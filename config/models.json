{
  "version": "0.1.0",
  "description": "Canonical model assignments per agent role across Paperclip companies.",
  "ceo": {
    "model": "claude-opus-4-8",
    "adapter": "claude_local",
    "auth": "claude_ai_subscription_oauth"
  },
  "worker": {
    "model": "gpt-5.5",
    "adapter": "codex_local",
    "auth": "chatgpt_subscription_oauth",
    "dangerouslyBypassApprovalsAndSandbox": true
  },
  "knowledge_keeper": {
    "model": "claude-sonnet-latest",
    "adapter": "claude_local",
    "auth": "claude_ai_subscription_oauth"
  },
  "researcher": {
    "model": "gpt-5.5",
    "adapter": "codex_local",
    "auth": "chatgpt_subscription_oauth"
  },
  "reviewer": {
    "model": "gpt-5.5",
    "adapter": "codex_local",
    "auth": "chatgpt_subscription_oauth",
    "purpose": "review-only; never self-review",
    "self_review_prohibited": true
  },
  "policy": {
    "api_direct_use_forbidden": true,
    "exception": "embedding endpoints only"
  }
}
